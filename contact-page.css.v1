:root {
    font-size: 112%;
}

/* Contact Page Styles */

.contact-hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 80px 20px 60px;
    text-align: center;
    color: white;
}

.contact-logo {
    max-width: 200px;
    margin-bottom: 20px;
}

.contact-hero h1 {
    font-family: 'Russo One', sans-serif;
    font-size: 3rem;
    margin-bottom: 15px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.contact-hero .subtitle {
    font-family: 'Teko', sans-serif;
    font-size: 1.8rem;
    font-weight: 600;
    opacity: 0.95;
    margin-bottom: 15px;
}

.contact-hero .hero-description {
    font-size: 1.2rem;
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto;
    opacity: 0.9;
}

.contact-main-section {
    padding: 80px 20px;
    background: #f8f9fa;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    max-width: 1200px;
    margin: 0 auto;
}

.contact-left-col h2 {
    font-family: 'Russo One', sans-serif;
    font-size: 2.2rem;
    color: #333;
    margin-bottom: 15px;
}

.intro-text {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #555;
    margin-bottom: 30px;
}

.contact-info-block {
    background: white;
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 30px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}

.contact-info-block h3 {
    font-family: 'Russo One', sans-serif;
    font-size: 1.6rem;
    color: #333;
    margin-bottom: 20px;
}

.contact-info-item {
    font-size: 1.05rem;
    padding: 12px 0;
    border-bottom: 1px solid #e0e0e0;
    color: #333;
    line-height: 1.6;
}

.contact-info-item:last-child {
    border-bottom: none;
}

.contact-info-item a {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
}

.contact-info-item a:hover {
    text-decoration: underline;
}

.contact-form {
    background: white;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    font-family: 'Teko', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.3s ease;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #667eea;
}

.recaptcha-placeholder {
    background: #f0f0f0;
    padding: 20px;
    text-align: center;
    border-radius: 8px;
    color: #999;
    font-style: italic;
}

.cta-button {
    width: 100%;
    background: linear-gradient(135deg, #ff6b9d 0%, #c239b3 100%);
    color: white;
    font-family: 'Teko', sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
    padding: 18px 30px;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(255, 107, 157, 0.3);
}

.cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 107, 157, 0.4);
}

.form-note {
    font-size: 0.95rem;
    color: #666;
    margin-top: 15px;
    text-align: center;
}

.form-note a {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
}

.contact-right-col h3 {
    font-family: 'Russo One', sans-serif;
    font-size: 1.8rem;
    color: #333;
    margin-bottom: 20px;
}

.map-container {
    background: white;
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 30px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}

.map-intro {
    font-size: 1rem;
    color: #666;
    margin-bottom: 15px;
    line-height: 1.6;
}

.map-embed {
    margin-bottom: 15px;
}

.directions-link {
    display: inline-block;
    color: #667eea;
    font-weight: 600;
    text-decoration: none;
    font-size: 1.1rem;
}

.directions-link:hover {
    text-decoration: underline;
}

.trust-factors {
    background: white;
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 30px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}

.trust-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.trust-list li {
    font-size: 1.05rem;
    padding: 12px 0;
    border-bottom: 1px solid #e0e0e0;
    color: #333;
    line-height: 1.6;
}

.trust-list li:last-child {
    border-bottom: none;
}

.credentials-section {
    background: white;
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 30px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}

.credentials-section h4 {
    font-family: 'Teko', sans-serif;
    font-size: 1.6rem;
    color: #333;
    margin-bottom: 15px;
}

.credentials-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.credentials-list li {
    font-size: 1.05rem;
    padding: 10px 0;
    color: #555;
}

.testimonials-section {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}

.testimonials-section h4 {
    font-family: 'Teko', sans-serif;
    font-size: 1.6rem;
    color: #333;
    margin-bottom: 20px;
}

.testimonial-item {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 15px;
    border-left: 4px solid #667eea;
}

.testimonial-item p {
    font-size: 1rem;
    line-height: 1.7;
    color: #555;
    margin-bottom: 10px;
    font-style: italic;
}

.testimonial-item cite {
    font-size: 0.95rem;
    color: #667eea;
    font-weight: 600;
    font-style: normal;
}

.review-us-button {
    display: inline-block;
    background: #4285f4;
    color: white;
    padding: 12px 25px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    margin-top: 15px;
    transition: background 0.3s ease;
}

.review-us-button:hover {
    background: #3367d6;
}

/* Location-Specific Content Section */
.location-content-section {
    padding: 80px 20px;
    background: white;
}

.location-content-section h2 {
    font-family: 'Russo One', sans-serif;
    font-size: 2.5rem;
    text-align: center;
    color: #333;
    margin-bottom: 30px;
}

.location-intro {
    font-size: 1.2rem;
    line-height: 1.8;
    text-align: center;
    max-width: 900px;
    margin: 0 auto 50px;
    color: #555;
}

.neighborhoods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    max-width: 1000px;
    margin: 0 auto 50px;
}

.neighborhood-card {
    background: #f8f9fa;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
}

.neighborhood-card h4 {
    font-family: 'Teko', sans-serif;
    font-size: 1.6rem;
    color: #667eea;
    margin-bottom: 15px;
}

.neighborhood-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.neighborhood-card li {
    font-size: 1.05rem;
    padding: 8px 0;
    color: #555;
    border-bottom: 1px solid #e0e0e0;
}

.neighborhood-card li:last-child {
    border-bottom: none;
}

.local-expertise {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 15px;
    color: white;
}

.local-expertise h3 {
    font-family: 'Russo One', sans-serif;
    font-size: 2rem;
    margin-bottom: 20px;
}

.local-expertise p {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 15px;
    opacity: 0.95;
}

.local-expertise p:last-child {
    margin-bottom: 0;
}

/* Amenities Section */
.amenities-section {
    padding: 80px 20px;
    background: #f8f9fa;
}

.amenities-section h2 {
    font-family: 'Russo One', sans-serif;
    font-size: 2.5rem;
    text-align: center;
    color: #333;
    margin-bottom: 50px;
}

.amenities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    max-width: 1100px;
    margin: 0 auto;
}

.amenity-item {
    text-align: center;
    padding: 35px 25px;
    background: white;
    border-radius: 12px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
}

.amenity-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
}

.amenity-icon {
    font-size: 3.5rem;
    margin-bottom: 15px;
}

.amenity-item h4 {
    font-family: 'Teko', sans-serif;
    font-size: 1.5rem;
    color: #667eea;
    margin-bottom: 10px;
}

.amenity-item p {
    font-size: 1rem;
    line-height: 1.6;
    color: #666;
}

/* Final CTA Section */
.final-cta-section {
    padding: 80px 20px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    text-align: center;
}

.final-cta-section h2 {
    font-family: 'Russo One', sans-serif;
    font-size: 2.5rem;
    margin-bottom: 20px;
}

.final-cta-section p {
    font-size: 1.2rem;
    line-height: 1.7;
    max-width: 700px;
    margin: 0 auto 30px;
    opacity: 0.95;
}

.cta-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.cta-button-primary,
.cta-button-secondary {
    padding: 18px 40px;
    font-size: 1.3rem;
    font-family: 'Teko', sans-serif;
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    transition: all 0.3s ease;
    display: inline-block;
}

.cta-button-primary {
    background: #ff6b9d;
    color: white;
    box-shadow: 0 4px 15px rgba(255, 107, 157, 0.4);
}

.cta-button-primary:hover {
    background: #ff4d7d;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 107, 157, 0.5);
}

.cta-button-secondary {
    background: white;
    color: #667eea;
}

.cta-button-secondary:hover {
    background: #f0f0f0;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.3);
}

.cta-note {
    font-size: 1rem;
    opacity: 0.9;
}

/* Footer Styles */
footer {
    background: #2C3E5C;
    color: white;
    padding: 50px 20px 20px;
}

.footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto 30px;
}

.footer-col h4 {
    font-family: 'Teko', sans-serif;
    font-size: 1.4rem;
    margin-bottom: 15px;
}

.footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.footer-col li {
    margin-bottom: 10px;
}

.footer-col a {
    color: white;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.3s ease;
}

.footer-col a:hover {
    opacity: 1;
}

.footer-col p {
    margin: 8px 0;
    opacity: 0.8;
}

.social-links {
    display: flex;
    gap: 15px;
}

.social-links a {
    display: inline-block;
    padding: 8px 15px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 5px;
}

.footer-bottom {
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.9rem;
    opacity: 0.7;
}

/* Mobile Responsive */
@media (max-width: 768px) {
    .contact-hero h1 {
        font-size: 2rem;
    }

    .contact-hero .subtitle {
        font-size: 1.4rem;
    }

    .contact-hero .hero-description {
        font-size: 1rem;
    }

    .contact-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .contact-left-col h2 {
        font-size: 1.8rem;
    }

    .location-content-section h2,
    .amenities-section h2,
    .final-cta-section h2 {
        font-size: 2rem;
    }

    .neighborhoods-grid {
        grid-template-columns: 1fr;
    }

    .amenities-grid {
        grid-template-columns: 1fr;
    }

    .cta-buttons {
        flex-direction: column;
        align-items: center;
    }

    .cta-button-primary,
    .cta-button-secondary {
        width: 100%;
        max-width: 300px;
    }

    .footer-content {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .social-links {
        justify-content: center;
    }
}
